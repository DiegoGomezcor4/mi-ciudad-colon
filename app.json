{
  "expo": {
    "name": "Mi Ciudad Colón",
    "slug": "mi-ciudad-colon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "miciudadcolon",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.uner.miciudadcolon",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSCameraUsageDescription": "Necesitamos acceso a la cámara para escanear los códigos QR de los lugares y sacar fotos de tus visitas.",
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para mostrarte qué lugares turísticos tenés cerca en Colón.",
        "NSPhotoLibraryUsageDescription": "Necesitamos acceso a tu galería para adjuntar fotos a tu recorrido.",
        "NSFaceIDUsageDescription": "Usamos Face ID para que puedas ingresar rápido a tu cuenta."
      }
    },
    "android": {
      "package": "com.uner.miciudadcolon",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir a Mi Ciudad Colón usar la cámara para escanear códigos QR y tomar fotos de tus visitas."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir a Mi Ciudad Colón acceder a tu ubicación para mostrarte lugares cercanos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir a Mi Ciudad Colón elegir fotos de tu galería para tu recorrido."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir a Mi Ciudad Colón usar biometría para ingresar rápido a tu cuenta."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-notifications",
      "@react-native-vector-icons/ionicons",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-asset",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5330f32a-2812-455a-9d38-89f2b6e25c94"
      }
    }
  }
}
